# Copy to .env for local development. Values here are for processes on the host
# (uv run …); docker-compose.yml overrides host names for containers. manage.py defaults to
# config.settings.local.
#
# SIMARIO_ENV_FILE=path/to/other.env   # read instead of this file (tests use it to isolate settings)

DJANGO_SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://simario:simario@127.0.0.1:5432/simario
REDIS_URL=redis://127.0.0.1:6379/0

S3_ENDPOINT_URL=http://127.0.0.1:9100
S3_ACCESS_KEY=simario
S3_SECRET_KEY=simario-secret
S3_BUCKET=simario
# Host the download URLs are signed for (what the /storage proxy forwards to).
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9100
S3_PUBLIC_PREFIX=/storage

SIMARIO_DEV_TOOLS=true

# Keycloak (OIDC). Local realm values; replace for sso.ikn.go.id.
# Staff search (GET /api/v1/staff) uses the same client through its service account, which
# needs the realm-management role view-users.
OIDC_ISSUER=http://127.0.0.1:8080/realms/otorita-ikn
OIDC_CLIENT_ID=simario
OIDC_CLIENT_SECRET=simario-local-secret
OIDC_NIP_CLAIM=nip
OIDC_REDIRECT_URI=http://localhost:5173/oidc/callback/
# How the server reaches the issuer when it differs from the browser address (empty = same).
OIDC_BACKCHANNEL_URL=

# Local Keycloak admin console (http://127.0.0.1:8080)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
