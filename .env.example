# Copy to .env for local development. Values here are for processes on the host
# (uv run …); docker-compose.yml overrides host names for containers.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://simario:simario@localhost:5432/simario
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=simario
S3_SECRET_KEY=simario-secret
S3_BUCKET=simario

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

SIMARIO_DEV_TOOLS=true

# Keycloak (OIDC). Local realm values; replace for sso.ikn.go.id.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NIP_CLAIM=nip
OIDC_REDIRECT_URI=
