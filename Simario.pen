                          "type": "note",
                          "id": "pZrIE",
                          "name": "PRDRefs",
                          "width": 420,
                          "height": 120,
                          "content": "PRD: FR-AUT-001, FR-AUT-002 (tertutup), FR-AUT-008 (pesan sesi), §3.3 wireframe Sign in. BR-008."
                        }
