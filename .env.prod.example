# SIMARIO staging / production (docker-compose.prod.yml). Copy to .env.prod and fill in.
# Never commit the filled-in file. Staging and production differ only in these values.

# Django
DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# localhost: the container health check calls Django directly.
ALLOWED_HOSTS=simario-staging.ikn.go.id,localhost
CSRF_TRUSTED_ORIGINS=https://simario-staging.ikn.go.id
# Staging only, for UAT that needs a shifted date; must be false in production and during the
# PPK trial (spec §4.5).
SIMARIO_DEV_TOOLS=false
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

# Public address (nginx)
PUBLIC_HOSTNAME=simario-staging.ikn.go.id
HTTPS_PORT=443
HTTP_PORT=80
# Certificate and key mounted into nginx (fullchain + private key, PEM).
TLS_CERT_DIR=./infra/nginx/certs

# PostgreSQL
POSTGRES_DB=simario
POSTGRES_USER=simario
POSTGRES_PASSWORD=change-me

# Object storage (RustFS; any S3 service works)
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
S3_BUCKET=simario
# Download URLs are signed for the host nginx forwards /storage to (internal name).
S3_PUBLIC_ENDPOINT=http://storage:9000
S3_PUBLIC_PREFIX=/storage

# Keycloak OIKN (sso.ikn.go.id) — leave empty until access exists; local accounts still work.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NIP_CLAIM=nip
OIDC_REDIRECT_URI=https://simario-staging.ikn.go.id/oidc/callback/
OIDC_BACKCHANNEL_URL=

# Frontend trial build: hide modules still running on local data (spec §4.10).
VITE_HIDE_UNMIGRATED=true
